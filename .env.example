# ==============================================================================
# AI Pothole Detection & Work-Order System Environment Configuration
# Copy this file to .env and adjust the values according to your environment.
# ==============================================================================

# MongoDB Connection URI (Local instance or MongoDB Atlas cluster)
MONGO_URI=mongodb://localhost:27017/pothole_detection

# Backend Service Configuration
PORT=5000
BACKEND_API_URL=http://127.0.0.1:5000/api/v1/potholes

# Smartphone IP Webcam Telemetry
# Run the "IP Webcam" app on Android/iOS and specify your device's LAN IP address:
PHONE_STREAM_URL=http://192.168.1.100:8080/video
PHONE_GPS_URL=http://192.168.1.100:8080/sensors.json

# Edge Hardware & Model Configuration
# device: '0' for NVIDIA RTX 4060 GPU with CUDA, or 'cpu' for fallback
EDGE_DEVICE=0
MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.35

# Fallback & Webcam Overrides (set to true to test locally using your PC webcam)
USE_WEBCAM=false
WEBCAM_INDEX=0
